# @medusajs/types declares an OPTIONAL peer on vite@^5.4.21 (type-only);
# this app is on vite 8. npm 10's `npm ci` hard-fails on that peer conflict
# (npm 11 and yarn 1 only warn), which is why CI broke when it moved from
# yarn to npm ci. Same approach as MythOSLinux/TYCHE's commerce/.npmrc.
legacy-peer-deps=true
